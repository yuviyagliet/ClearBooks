{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "https://clearbooks-ruddy.vercel.app" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://vercel.live; style-src 'self' 'unsafe-inline'; img-src 'self' data: https: blob:; font-src 'self' data:; connect-src 'self' https://*.supabase.co https://vercel.live wss://*.supabase.co; frame-ancestors 'none'" }
      ]
    }
  ],
  "redirects": [
    { "source": "/.env", "destination": "/404", "statusCode": 404 },
    { "source": "/.env.local", "destination": "/404", "statusCode": 404 },
    { "source": "/.git/:path*", "destination": "/404", "statusCode": 404 },
    { "source": "/package.json", "destination": "/404", "statusCode": 404 }
  ],
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
}
